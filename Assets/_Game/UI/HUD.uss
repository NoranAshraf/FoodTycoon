/* Designed against a 1080x2400 reference resolution (see HUDPanelSettings). */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- top bar / money ---- */

.top-bar {
    position: absolute;
    top: 48px;
    right: 36px;
    flex-direction: row;
}

.pill {
    flex-direction: row;
    align-items: center;
    height: 104px;
    min-width: 330px;
    padding: 0 40px 0 16px;
    background-color: rgb(255, 255, 255);
    border-width: 5px;
    border-color: rgb(62, 63, 124);
    border-radius: 60px;
}

.pill__text {
    flex-grow: 1;
    font-size: 58px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(47, 47, 91);
}

.cash {
    width: 88px;
    height: 56px;
    margin-right: 14px;
    justify-content: center;
    align-items: center;
    background-color: rgb(88, 187, 98);
    border-width: 4px;
    border-color: rgb(58, 142, 68);
    border-radius: 10px;
}

.cash__band {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 30px;
    right: 30px;
    background-color: rgb(233, 120, 150);
    border-radius: 4px;
}

.cash__coin {
    width: 30px;
    height: 30px;
    background-color: rgb(222, 245, 218);
    border-width: 3px;
    border-color: rgb(58, 142, 68);
    border-radius: 15px;
}

/* ---- sell button ---- */

.sell-button {
    position: absolute;
    left: 0;
    top: 57%;
    width: 240px;
    height: 205px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(248, 198, 47);
    border-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 44px;
    border-bottom-right-radius: 44px;
}

.sell-button:hover {
    background-color: rgb(255, 212, 74);
}

.sell-button:active {
    background-color: rgb(229, 178, 31);
    scale: 0.96 0.96;
}

.sell-button__title {
    margin-top: 6px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 74, 130);
}

.sell-button__amount {
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(48, 48, 80);
}

/* gift icon, drawn with plain elements */

.gift {
    width: 76px;
    height: 70px;
    align-items: center;
}

.gift__box {
    position: absolute;
    top: 22px;
    left: 6px;
    right: 6px;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(225, 105, 105);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.gift__lid {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 20px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(225, 105, 105);
    border-radius: 6px;
}

.gift__ribbon-v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 12px;
    margin-left: -6px;
    background-color: rgb(232, 69, 60);
}

.gift__ribbon-h {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    height: 12px;
    background-color: rgb(232, 69, 60);
}

.gift__bow {
    position: absolute;
    top: 0;
    width: 22px;
    height: 16px;
    background-color: rgb(232, 69, 60);
    border-radius: 11px;
}

.gift__bow--left {
    left: 18px;
}

.gift__bow--right {
    right: 18px;
}

/* ---- bottom bar / upgrade buttons ---- */

.bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 90px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.upgrade-button {
    width: 340px;
    height: 300px;
    margin: 0 22px;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(255, 255, 255);
    border-width: 6px;
    border-color: rgb(62, 63, 124);
    border-radius: 44px;
    overflow: visible;
}

.upgrade-button:hover {
    background-color: rgb(246, 246, 255);
}

.upgrade-button:active {
    background-color: rgb(232, 232, 246);
    scale: 0.96 0.96;
}

.upgrade-button:disabled {
    opacity: 1;
    background-color: rgb(206, 208, 222);
    border-color: rgb(143, 146, 176);
}

.upgrade-button__icon {
    width: 130px;
    height: 120px;
    margin-top: 26px;
}

.upgrade-button__title {
    margin-top: 14px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(62, 63, 124);
}

.upgrade-button:disabled .upgrade-button__title {
    color: rgb(112, 114, 146);
}

.price-tag {
    position: absolute;
    bottom: -34px;
    height: 72px;
    min-width: 190px;
    padding: 0 30px;
    justify-content: center;
    background-color: rgb(88, 187, 98);
    border-width: 5px;
    border-color: rgb(58, 142, 68);
    border-radius: 36px;
}

.upgrade-button:disabled .price-tag {
    background-color: rgb(150, 153, 176);
    border-color: rgb(112, 114, 146);
}

.price-tag__text {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

/* machine icon: purple grinder body with a hopper and a plus badge */

.machine-icon__body {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 34px;
    bottom: 8px;
    background-color: rgb(130, 64, 176);
    border-width: 4px;
    border-color: rgb(84, 40, 118);
    border-radius: 16px;
}

.machine-icon__window {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 16px;
    height: 26px;
    background-color: rgb(56, 178, 212);
    border-radius: 8px;
}

.machine-icon__hopper {
    position: absolute;
    left: 34px;
    right: 34px;
    top: 4px;
    height: 40px;
    background-color: rgb(0, 179, 212);
    border-width: 4px;
    border-color: rgb(0, 120, 150);
    border-radius: 20px;
}

.machine-icon__plus {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    background-color: rgb(88, 187, 98);
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    border-radius: 24px;
}

.machine-icon__plus-h {
    position: absolute;
    width: 24px;
    height: 6px;
    background-color: rgb(255, 255, 255);
}

.machine-icon__plus-v {
    position: absolute;
    width: 6px;
    height: 24px;
    background-color: rgb(255, 255, 255);
}

/* merge icon: two small cubes folding into one bigger green one */

.merge-icon__cube {
    position: absolute;
    top: 8px;
    width: 40px;
    height: 40px;
    background-color: rgb(130, 64, 176);
    border-width: 4px;
    border-color: rgb(84, 40, 118);
    border-radius: 10px;
}

.merge-icon__cube--left {
    left: 4px;
}

.merge-icon__cube--right {
    right: 4px;
}

.merge-icon__arrow {
    position: absolute;
    top: 48px;
    width: 26px;
    height: 8px;
    background-color: rgb(62, 63, 124);
    border-radius: 4px;
}

.merge-icon__arrow--left {
    left: 18px;
    rotate: 40deg;
}

.merge-icon__arrow--right {
    right: 18px;
    rotate: -40deg;
}

.merge-icon__result {
    position: absolute;
    left: 37px;
    bottom: 0;
    width: 56px;
    height: 56px;
    background-color: rgb(88, 187, 98);
    border-width: 4px;
    border-color: rgb(58, 142, 68);
    border-radius: 14px;
}
