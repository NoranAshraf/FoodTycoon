<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="UpgradesPanel.uss" />
    <ui:VisualElement name="upgrade-row" class="upgrade-row">
        <ui:VisualElement name="row-icon" class="upgrade-row__icon" picking-mode="Ignore" />
        <ui:VisualElement name="row-body" class="upgrade-row__body" picking-mode="Ignore">
            <ui:Label name="row-title" class="upgrade-row__title" text="+UPGRADE" />
            <ui:VisualElement class="upgrade-row__track" picking-mode="Ignore">
                <ui:VisualElement name="row-progress-fill" class="upgrade-row__fill" picking-mode="Ignore" />
                <ui:Label name="row-level" class="upgrade-row__level" text="LV 0/10" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="row-buy" class="upgrade-row__buy">
            <ui:VisualElement class="cash upgrade-row__cash" picking-mode="Ignore">
                <ui:VisualElement class="cash__band" picking-mode="Ignore" />
                <ui:VisualElement class="cash__coin" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="row-price" class="upgrade-row__price" text="$20" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
